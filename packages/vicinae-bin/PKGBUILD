# Maintainer: Slate contributors

pkgname=vicinae-bin
pkgver=0.28.2
pkgrel=1
pkgdesc="A focused launcher for your desktop - native, fast, extensible"
arch=('x86_64')
url="https://github.com/vicinaehq/vicinae"
license=('GPL-3.0-only')
depends=(
  layer-shell-qt
  libqalculate
  nodejs
  qt6-base
  qt6-declarative
  qt6-svg
  qtkeychain-qt6
  syntax-highlighting
)
provides=('vicinae')
conflicts=('vicinae')
options=('!debug')
noextract=("vicinae-${arch}-v${pkgver}-${pkgrel}.tar.gz")
source=(
  "vicinae-${arch}-v${pkgver}-${pkgrel}.tar.gz::${url}/releases/download/v${pkgver}/vicinae-linux-${arch}-v${pkgver}.tar.gz"
  'vicinae.hook'
)
sha256sums=(
  'f6e8369425b1f9839179adb7071f24a78f17c2dcc48f4c7ff0e8384ea6d5c696'
  '4819cd2c3fa9f9cc01b685962efb6e58cfa17b79ae9eae5d91d780cb3ba5f2a8'
)

prepare() {
  mkdir -p vicinae
  bsdtar -xf "vicinae-${arch}-v${pkgver}-${pkgrel}.tar.gz" -C vicinae
}

package() {
  install -d "$pkgdir/usr"
  cp -a vicinae/. "$pkgdir/usr/"

  install -Dm644 vicinae.hook \
    "$pkgdir/usr/share/libalpm/hooks/vicinae.hook"
}
