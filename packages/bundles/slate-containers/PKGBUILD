# Maintainer: Slate contributors

pkgname=slate-containers
pkgver=1.0.0
pkgrel=1
pkgdesc="Slate's container stack: podman with rootless defaults"
arch=('any')
url="https://github.com/ani1797/slate"
license=('MIT')
depends=(
  slate-base
  podman
  podman-compose
  podman-docker
  # netavark/aardvark-dns are pinned explicitly: they're the provider
  # containers-common picks for the virtual container-network-stack package, and
  # leaving it unpinned makes pacman prompt interactively during mkarchiso's
  # unattended pacstrap, which would hang the build.
  aardvark-dns
  netavark
)
# Configuration is authored as a filesystem tree under rootfs/ rather than as
# individual source entries, so adding a file needs no PKGBUILD or checksum edit.
source=()
sha256sums=()

package() {
  cp -a "$startdir/rootfs/." "$pkgdir/"
}
