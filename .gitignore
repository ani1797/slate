/.build/
/out/
/work/
/.vm/
/.vmtest/

# makepkg build artifacts left in package source directories. The globs are
# double-starred because packages/ is tiered (meta/, bundles/, vendor/), so
# PKGBUILDs no longer sit at a fixed depth.
packages/**/pkg/
packages/**/src/
packages/**/*.pkg.tar.*
packages/**/*.tar.gz
packages/**/*.tar.xz

# Generated: the local package repository staged into the ISO by
# `make package-repo`, so the live session's pacstrap can resolve Slate's own
# packages offline while installing. See the Makefile's STAGED_REPO_DIR.
/archiso/airootfs/var/cache/slate/repo/
